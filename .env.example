APP_NAME=TravelConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

ADMIN_IDLE_TIMEOUT_MINUTES=20
ADMIN_LOGIN_CODE_EXPIRES_MINUTES=1
ADMIN_LOGIN_CODE_MAX_ATTEMPTS=5
ADMIN_PASSWORD_LOCKOUT_ATTEMPTS=5
ADMIN_PASSWORD_LOCKOUT_MINUTES=15
ADMIN_LOGIN_CODE_RESEND_SECONDS=60
ADMIN_LOGIN_CODE_RATE_LIMIT=5
ADMIN_TRUSTED_DEVICE_COOKIE=travelconnect-admin-device
ADMIN_TRUSTED_DEVICE_DAYS=90
ADMIN_LOGIN_EVENT_RETENTION_DAYS=180
ADMIN_FAILED_ALERT_THRESHOLD=5
ADMIN_FAILED_ALERT_WINDOW_MINUTES=10
ADMIN_FAILED_ALERT_COOLDOWN_MINUTES=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"
